{
  "model_id": "google/gemma-2-2b-it",
  "train_path": "data/finetune/splits/train.jsonl",
  "validation_path": "data/finetune/splits/validation.jsonl",

  "max_length": 512,
  "num_train_epochs": 3,
  "per_device_train_batch_size": 1,
  "per_device_eval_batch_size": 1,
  "gradient_accumulation_steps": 4,

  "learning_rate": 0.0002,
  "weight_decay": 0.01,
  "warmup_ratio": 0.1,
  "lr_scheduler_type": "constant",
  "max_grad_norm": 1.0,

  "lora_r": 16,
  "lora_alpha": 32,
  "lora_dropout": 0.05,
  "target_modules": [
    "q_proj",
    "k_proj",
    "v_proj",
    "o_proj",
    "gate_proj",
    "up_proj",
    "down_proj"
  ],

  "seed": 42,
  "logging_steps": 5,
  "save_total_limit": 2,
  "attn_implementation": "eager"
}
